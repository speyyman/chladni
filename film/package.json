{
  "name": "chladni-film",
  "version": "1.0.0",
  "private": true,
  "description": "The film 'Sound, made visible': sand on a steel plate, rendered frame by frame from the chladni library.",
  "license": "MIT",
  "type": "module",
  "scripts": {
